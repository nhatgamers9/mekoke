    {
      "name": "habits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habits\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"clean_since\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "check_ins",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"check_ins\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"date\" TEXT NOT NULL UNIQUE, \"mood\" INTEGER NOT NULL CHECK(\"mood\" BETWEEN 1 AND 5), \"note\" TEXT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "fasts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"fasts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"plan\" TEXT NOT NULL, \"goal_minutes\" INTEGER NOT NULL CHECK(\"goal_minutes\" > 0), \"started_at\" INTEGER NOT NULL, \"ended_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "prefs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"prefs\" (\"name\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"name\"));"
        }
      ]
    },
    {
      "name": "money_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"money_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"amount_minor\" INTEGER NOT NULL CHECK(\"amount_minor\" BETWEEN 1 AND 999999999999), \"category\" TEXT NOT NULL, \"note\" TEXT NULL, \"date\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL);"
